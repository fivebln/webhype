---
/**
 * Analytics · webhype — consent-gated (DSGVO/TDDDG, §9.9)
 *
 * Lädt Google Tag Manager (GTM) und das Meta-Pixel ERST nach Opt-in über den
 * Cookie-Banner. Vor der Einwilligung wird nichts geladen und nichts übertragen
 * (Consent Mode v2, Default „denied").
 *
 * GA4 läuft INNERHALB von GTM (Gil, Self-Service). Das Meta-Pixel laden wir
 * BEWUSST direkt hier statt über GTM: so ist die Einwilligungs-Sperre im
 * versionierten Code nachweisbar und kann nicht durch eine GTM-Konfiguration
 * umgangen werden. ⚠️ Deshalb das Pixel NICHT zusätzlich in GTM anlegen —
 * sonst feuert jeder Seitenaufruf doppelt.
 *
 * Kein <noscript>-Pixel-Bild: das würde ohne Einwilligung feuern (§9.9).
 *
 * IDs kommen aus Coolify-Env (PUBLIC_*, is_literal:false), zur Render-Zeit via
 * process.env gelesen (nicht import.meta.env/Build-Only — vgl. Env-Memory).
 * Fehlende ID → der jeweilige Dienst ist ein No-op.
 *
 * GSC: bevorzugt DNS-TXT (Hetzner). Optional Meta-Tag via PUBLIC_GSC_VERIFICATION.
 */
const gtmId = (process.env.PUBLIC_GTM_ID ?? '').trim();
const gscToken = (process.env.PUBLIC_GSC_VERIFICATION ?? '').trim();
const pixelId = (process.env.PUBLIC_META_PIXEL_ID ?? '').trim();
const validGtm = /^GTM-[A-Z0-9]+$/.test(gtmId);
const validPixel = /^\d{15,16}$/.test(pixelId);
---
{gscToken && <meta name="google-site-verification" content={gscToken} />}
{validGtm && <meta name="wh:gtm-id" content={gtmId} />}
{validPixel && <meta name="wh:meta-pixel-id" content={pixelId} />}
{(validGtm || validPixel) && (
  <script is:inline>
    (() => {
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = window.gtag || gtag;

      // Consent Mode v2 — Default: verweigert, bis der Nutzer einwilligt.
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });

      const lies = (name) => {
        const el = document.querySelector('meta[name="' + name + '"]');
        return el && el.getAttribute('content');
      };
      const GTM_ID = lies('wh:gtm-id');
      const PIXEL_ID = lies('wh:meta-pixel-id');

      function loadGTM() {
        if (!GTM_ID || window.__whGtmLoaded) return;
        window.__whGtmLoaded = true;
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        const j = document.createElement('script');
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + encodeURIComponent(GTM_ID);
        document.head.appendChild(j);
      }

      function loadMetaPixel() {
        if (!PIXEL_ID || window.__whPixelLoaded) return;
        window.__whPixelLoaded = true;
        // Offizieller fbq-Bootstrap (Meta) — erst hier, also erst NACH Einwilligung.
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
        (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        window.fbq('init', PIXEL_ID);
        window.fbq('track', 'PageView');
      }

      function grant() {
        // „Alle akzeptieren" deckt Statistik (GA4) UND Marketing (Meta-Pixel) —
        // so steht es im Banner und in der Datenschutzerklärung §5/§6.
        gtag('consent', 'update', {
          analytics_storage: 'granted',
          ad_storage: 'granted',
          ad_user_data: 'granted',
          ad_personalization: 'granted',
        });
        loadGTM();
        loadMetaPixel();
      }

      function readConsent() {
        const m = document.cookie.split('; ').find((c) => c.indexOf('cookie-consent=') === 0);
        return m ? m.split('=')[1] : null;
      }

      // Bereits eingewilligt (Folge-Besuch) → sofort laden.
      if (readConsent() === 'all') grant();

      // Frische Banner-Wahl.
      document.addEventListener('wh:consent', (e) => {
        if (e && e.detail === 'all') grant();
      });
    })();
  </script>
)}
