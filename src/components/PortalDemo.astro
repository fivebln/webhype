---
/**
 * PortalDemo · webhype — die Cockpit-Sektion mit erlebbarer Demo (Gil-Go 16.08.).
 *
 * Ersetzt den statischen PortalShowcase auf der Startseite. Prinzip: Der Besucher
 * ERLEBT die Portal-Mechanik in drei Schritten (tippen → Vorschau ändert sich →
 * veröffentlichen), statt über sie zu lesen. Fester Endpunkt mit CTA — die Demo
 * ist ein Aha-Moment, keine Spielwiese.
 *
 * Wichtig: Die Demo zeigt die MECHANIK, nicht die Portal-Oberfläche im Detail —
 * sonst müsste sie bei jeder Portal-Änderung mitgepflegt werden und würde
 * irgendwann etwas zeigen, das Kunden so nicht bekommen. Der Beispielbetrieb
 * („Malerbetrieb Sommer") ist erkennbar fiktiv — kein erfundener Kunde (§9.2/§7).
 *
 * Rein clientseitig, kein Request, keine Cookies.
 */
---

<section class="relative overflow-hidden bg-ink-900 py-12 sm:py-16">
  <div class="absolute inset-0 grid-overlay opacity-30 pointer-events-none" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6">

    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="eyebrow is-light justify-center">Das bekommt sonst niemand hin</p>
      <h2 class="display-lg mt-3 text-white">Deine Website änderst du selbst.<br class="hidden sm:block" /> Probier es aus — genau hier.</h2>
      <p class="mt-4 text-lg leading-relaxed text-blue-100/90">
        Jede webhype-Website kommt mit deinem eigenen Cockpit: Texte tippen, Vorschau prüfen, veröffentlichen.
        Ohne Anruf, ohne Agentur-Rechnung. So fühlt sich das an:
      </p>
    </div>

    {/* ── Demo-Widget ─────────────────────────────────────────────── */}
    <div class="mx-auto mt-10 max-w-5xl" data-reveal>
      <div class="grid gap-4 lg:grid-cols-[0.9fr_1.1fr]">

        {/* Editor-Karte — mobil UNTER der Vorschau (beim Tippen muss die Änderung sichtbar sein) */}
        <div class="order-2 flex flex-col rounded-2xl bg-white p-5 sm:p-6 lg:order-1">
          <p class="text-xs font-semibold text-ink-400">
            <span id="pd-schritt" class="mr-1.5 inline-flex h-5 w-5 items-center justify-center rounded-full bg-blue-500 text-[11px] font-bold text-white">1</span>
            <span id="pd-schritt-text">Ändere die Überschrift — die Vorschau macht sofort mit</span>
          </p>

          <label for="pd-headline" class="mt-5 block text-sm font-medium text-ink-700">Große Überschrift</label>
          <input
            type="text"
            id="pd-headline"
            maxlength="60"
            value="Ihr Malerbetrieb in Berlin. Sauber, pünktlich, seit 1998."
            class="mt-1.5 w-full rounded-md border border-ink-200 px-3.5 py-2.5 text-[15px] text-ink-900 transition focus:border-blue-500 focus:outline-none focus:ring-4 focus:ring-blue-100"
          />
          <p class="mt-1 text-right text-[11px] text-ink-300"><span id="pd-zeichen">55</span>/60 Zeichen</p>

          <label for="pd-button" class="mt-3 block text-sm font-medium text-ink-700">Beschriftung des Knopfs</label>
          <input
            type="text"
            id="pd-button"
            maxlength="24"
            value="Angebot anfordern"
            class="mt-1.5 w-full rounded-md border border-ink-200 px-3.5 py-2.5 text-[15px] text-ink-900 transition focus:border-blue-500 focus:outline-none focus:ring-4 focus:ring-blue-100"
          />

          <div class="mt-auto flex items-center gap-3 pt-6">
            <button
              type="button"
              id="pd-publish"
              class="inline-flex items-center gap-2 rounded-md bg-blue-500 px-5 py-2.5 text-[15px] font-semibold text-white transition hover:bg-blue-400 disabled:cursor-default disabled:bg-success"
            >Veröffentlichen</button>
            <span id="pd-publish-hint" class="text-[13px] text-ink-400">…und die Änderung ist live.</span>
          </div>
        </div>

        {/* Vorschau — fiktiver Beispielbetrieb im Browser-Rahmen */}
        <div class="order-1 overflow-hidden rounded-2xl bg-white lg:order-2">
          <div class="flex items-center gap-2 border-b border-ink-100 bg-ink-50 px-4 py-2.5">
            <span class="flex gap-1.5" aria-hidden="true">
              <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-ink-200"></span>
            </span>
            <span class="ml-2 flex-1 truncate rounded-md border border-ink-100 bg-white px-3 py-1 text-[11px] text-ink-400">malerbetrieb-sommer.de <span class="text-ink-300">(Beispiel)</span></span>
            <span id="pd-live-badge" class="hidden items-center gap-1 rounded-full bg-success/15 px-2 py-0.5 text-[11px] font-semibold text-success">
              <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 6 5 9 10 3"/></svg>
              Online — gerade eben
            </span>
          </div>

          {/* Mini-Website des Beispielbetriebs */}
          <div class="pd-site p-6 sm:p-8">
            <div class="flex items-center justify-between">
              <span class="text-sm font-bold tracking-tight text-[#3D2E1E]">Malerbetrieb Sommer</span>
              <span class="hidden gap-4 text-[11px] text-[#8A7A66] sm:flex"><span>Leistungen</span><span>Referenzen</span><span>Kontakt</span></span>
            </div>
            <h3 id="pd-preview-headline" class="mt-7 max-w-md font-serif text-2xl leading-snug text-[#2B2013] sm:text-[27px]">
              Ihr Malerbetrieb in Berlin. Sauber, pünktlich, seit 1998.
            </h3>
            <p class="mt-3 max-w-sm text-[13px] leading-relaxed text-[#6E5F4D]">
              Innenanstrich, Fassade und Lackierarbeiten — vom Meisterbetrieb, zum vereinbarten Termin.
            </p>
            <span id="pd-preview-button" class="mt-5 inline-block rounded-md bg-[#C4622D] px-4 py-2 text-[13px] font-semibold text-white">Angebot anfordern</span>
            <div class="mt-7 flex gap-2" aria-hidden="true">
              <span class="h-14 flex-1 rounded-md bg-[#EAD9C4]"></span>
              <span class="h-14 flex-1 rounded-md bg-[#E2CBAE]"></span>
              <span class="h-14 flex-1 rounded-md bg-[#D9BC97]"></span>
            </div>
          </div>
        </div>
      </div>

      {/* Auflösung nach dem Veröffentlichen */}
      <div id="pd-fertig" class="mt-4 hidden rounded-2xl border border-success/25 bg-success/10 p-5 text-center sm:p-6">
        <p class="text-lg font-semibold text-white headline">Das war der ganze Vorgang.</p>
        <p class="mx-auto mt-1.5 max-w-xl text-[15px] leading-relaxed text-blue-100/90">
          Genau so pflegst du deine echte Website bei uns — Öffnungszeiten, Preise, Fotos, wann immer du willst.
          Im Rundum-Service ab 19&nbsp;€ im Monat inklusive, zusammen mit Hosting, Sicherheit und täglichem Check.
        </p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
          <a href="/website-check" class="inline-flex items-center gap-2 rounded-md bg-blue-500 px-5 py-2.5 text-[15px] font-semibold text-white transition hover:bg-blue-400">Und was kann deine Website? Zum Check <span aria-hidden="true">→</span></a>
          <a href="/leistungsumfang" class="inline-flex items-center gap-2 rounded-md border border-white/25 px-5 py-2.5 text-[15px] font-medium text-white transition hover:bg-white/10">Alles, was drinsteckt</a>
        </div>
      </div>
    </div>

    {/* Drei Belege statt sechs Karten */}
    <div class="mx-auto mt-10 grid max-w-5xl gap-4 sm:grid-cols-3" data-reveal-group>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
        <h3 class="text-base font-bold text-white headline">Texte & Bilder selbst ändern</h3>
        <p class="mt-2 text-[14px] leading-relaxed text-blue-100/80">Mit Live-Vorschau wie hier oben. Layout und Design bleiben fest — du kannst nichts kaputt machen.</p>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
        <h3 class="text-base font-bold text-white headline">Verträge & Rechnungen an einem Ort</h3>
        <p class="mt-2 text-[14px] leading-relaxed text-blue-100/80">Kein Suchen im Mail-Postfach — alles liegt in deinem Cockpit, jederzeit abrufbar.</p>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-6">
        <h3 class="text-base font-bold text-white headline">Du siehst, was wir tun</h3>
        <p class="mt-2 text-[14px] leading-relaxed text-blue-100/80">Status, Sicherheit und Backups deiner Seite auf einen Blick — der Monatsbeitrag arbeitet sichtbar.</p>
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const kopf = document.getElementById('pd-headline') as HTMLInputElement | null;
    const knopf = document.getElementById('pd-button') as HTMLInputElement | null;
    const zeichen = document.getElementById('pd-zeichen');
    const vKopf = document.getElementById('pd-preview-headline');
    const vKnopf = document.getElementById('pd-preview-button');
    const publish = document.getElementById('pd-publish') as HTMLButtonElement | null;
    const hint = document.getElementById('pd-publish-hint');
    const badge = document.getElementById('pd-live-badge');
    const fertig = document.getElementById('pd-fertig');
    const schritt = document.getElementById('pd-schritt');
    const schrittText = document.getElementById('pd-schritt-text');
    if (!kopf || !knopf || !vKopf || !vKnopf || !publish) return;

    let getippt = false;

    const uebernehmen = () => {
      vKopf.textContent = kopf.value.trim() || 'Ihr Malerbetrieb in Berlin.';
      vKnopf.textContent = knopf.value.trim() || 'Angebot anfordern';
      if (zeichen) zeichen.textContent = String(kopf.value.length);
      if (!getippt) {
        getippt = true;
        if (schritt) schritt.textContent = '2';
        if (schrittText) schrittText.textContent = 'Passt? Dann veröffentlichen.';
      }
    };
    kopf.addEventListener('input', uebernehmen);
    knopf.addEventListener('input', uebernehmen);

    publish.addEventListener('click', () => {
      if (publish.disabled) return;
      publish.disabled = true;
      publish.innerHTML = '<svg width="14" height="14" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="2 6 5 9 10 3"/></svg> Veröffentlicht';
      if (hint) hint.textContent = 'Deine Änderung ist live.';
      if (badge) { badge.classList.remove('hidden'); badge.classList.add('inline-flex'); }
      if (schritt) schritt.textContent = '3';
      if (schrittText) schrittText.textContent = 'Fertig — schneller als jede Mail an eine Agentur.';
      if (fertig) {
        fertig.classList.remove('hidden');
        // Erst zeigen, dann sanft hinscrollen — der Abschluss gehört ins Bild.
        setTimeout(() => fertig.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 150);
      }
    });
  })();
</script>

<style>
  /* Fiktiver Beispielbetrieb — bewusst eigene, warme Palette (klar KEIN webhype-Look),
     damit „das ist eine andere Website" auf einen Blick erkennbar ist. */
  .pd-site {
    background: linear-gradient(180deg, #FAF3E8 0%, #F4E8D6 100%);
  }
  .pd-site .font-serif { font-family: Georgia, 'Times New Roman', serif; }
</style>
