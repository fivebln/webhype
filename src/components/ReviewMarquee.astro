---
/**
 * ReviewMarquee — schmales, durchlaufendes Band mit Kundenstimmen (Hero unten).
 * Bewegung zieht kurz Aufmerksamkeit; nichts muss gelesen werden.
 * Pausiert bei Hover, respektiert prefers-reduced-motion.
 *
 * ⚠️ PLATZHALTER: Bis auf Felix K. & Max H. sind die Stimmen erfunden,
 *    um das Band zu füllen. Vor Live durch echte, freigegebene Zitate ersetzen.
 */
const reviews = [
  // NUR wörtliche Auszüge aus den freigegebenen Kundenzitaten auf /referenzen
  // (MARKETING.md §7: keine erfundenen Kunden/Testimonials — Bereinigung 16.08.2026,
  // vorher standen hier fünf ausgedachte Namen).
  { quote: 'Jetzt kommen die Leute zu mir, statt dass ich hinterherlaufe.', name: 'Felix K.' },
  { quote: 'Keine ewigen Korrekturschleifen, kein großes Shooting.', name: 'Maximilian H.' },
  { quote: 'Eine Seite, die wirklich nach mir klingt.', name: 'Paul A.' },
  { quote: 'So bleibe ich präsent, ohne ständig hinterherzutelefonieren.', name: 'Alexander M.' },
  { quote: 'Unsere zwei Websites pflege ich bequem über einen einzigen Zugang.', name: 'Maximilian H.' },
];
// zwei Kopien für nahtlose Schleife (Animation schiebt um -50 %)
const loop = [...reviews, ...reviews];
---

<div class="review-marquee" role="region" aria-label="Kundenstimmen">
  <div class="review-marquee-track">
    {loop.map((r) => (
      <span class="review-chip">
        <span class="review-chip-top">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span class="review-quote">„{r.quote}"</span>
        </span>
        <span class="review-name">— {r.name}</span>
      </span>
    ))}
  </div>
</div>
